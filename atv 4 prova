#include <stdio.h>
int main() {
    int ano;
    printf("digite um ano: ");
    scanf("%d", &ano);
    if ((ano % 400 == 0) || ((ano % 4 == 0) && (ano % 100 != 0))) {
        printf("%d é um ano bissexto.\n", ano);
    } else {
        printf("%d nao é um ano bissexto.\n", ano);
    }
    return 0;
}
