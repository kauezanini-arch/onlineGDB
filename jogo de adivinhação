#include <stdio.h>
#include <stdlib.h>
#include <time.h>

// Função para avaliar o palpite do jogador
int avaliar_palpite(int palpite, int numero_secreto) {
    if (palpite > numero_secreto) {
        printf("Muito alto! Tente novamente.\n");
        return 0;
    } else if (palpite < numero_secreto) {
        printf("Muito baixo! Tente novamente.\n");
        return 0;
    } else {
        printf("Parabens! Voce acertou!\n");
        return 1;
    }
}

int main() {
    // Inicializa a semente do gerador de números aleatórios
    srand(time(NULL));
    
    // Define um número aleatório entre 1 e 100
    int numero_secreto = (rand() % 100) + 1;
    
    char entrada[50];
    int palpite = 0;
    int tentativas = 0;
    int acertou = 0;

    printf("Bem-vindo ao Jogo de Adivinhacao!\n");
    printf("Tente adivinhar o numero secreto entre 1 e 100.\n\n");

    // Loop continua até o usuário acertar
    while (!acertou) {
        printf("Digite seu palpite: ");
        
        // Lê a entrada do usuário como string de forma segura
        fgets(entrada, sizeof(entrada), stdin);
        
        // Converte a string para número inteiro
        palpite = atoi(entrada);
        tentativas++;

        // Chama a função para avaliar o palpite
        acertou = avaliar_palpite(palpite, numero_secreto);
    }

    printf("Voce precisou de %d tentativas para vencer.\n", tentativas);

    return 0;
}
