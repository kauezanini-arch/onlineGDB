#include <stdio.h>

int main() {
    int n, i;
    unsigned long long fatorial = 1; 

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &n);

   
    if (n < 0) {
        printf("erro! fatorial de numero negativo nao existe.\n");
    } else {
        for (i = 1; i <= n; ++i) {
            fatorial *= i;
        }
        printf("fatorial de%d =%llu\n", n, fatorial);
    }

    return 0;
}
